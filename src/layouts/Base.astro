---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'BTTMLINE, automatisering en AI die je bedrijf echt vooruit helpen.',
  description = 'Geen hype, geen cowboys. Senior engineers die je processen bekijken, eerlijk zeggen wat met automatisering of AI kan, en bouwen wat werkt. Voor Vlaamse bedrijven.',
  current,
} = Astro.props;

const siteBase = (Astro.site ?? new URL('https://www.bttmline.be')).href.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteBase).href;
const ogImage = new URL('/og-image.png', siteBase).href;

// Structured data (JSON-LD) for search engines and AI/GEO engines.
const orgId = siteBase + '/#organization';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'BTTMLINE',
      url: siteBase + '/',
      logo: siteBase + '/assets/bttmline-logo-white.png',
      image: ogImage,
      description: 'BTTMLINE bouwt automatisering en AI voor Vlaamse bedrijven. Senior software engineers die processen bekijken, eerlijk zeggen wat met automatisering of AI kan, en bouwen wat werkt.',
      slogan: 'Praktische AI, zonder hype.',
      email: 'info@bttmline.be',
      telephone: '+32485769705',
      address: { '@type': 'PostalAddress', streetAddress: 'Caetsbeekstraat 12', postalCode: '3740', addressLocality: 'Bilzen-Hoeselt', addressCountry: 'BE' },
      areaServed: { '@type': 'Country', name: 'België' },
      sameAs: ['https://www.linkedin.com/company/bttmline/'],
      founder: [
        { '@type': 'Person', name: 'Tom Kellens' },
        { '@type': 'Person', name: 'Ben Jorissen' },
      ],
      knowsAbout: [
        'Automatisering', 'Artificiële intelligentie', 'AI-agents', 'RPA',
        'Procesautomatisatie', 'Systeemintegraties', 'Maatwerksoftware', 'AI-strategie',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': siteBase + '/#website',
      url: siteBase + '/',
      name: 'BTTMLINE',
      inLanguage: 'nl-BE',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': siteBase + '/#website' },
      inLanguage: 'nl-BE',
    },
  ],
};
---
<!DOCTYPE html>
<html lang="nl-BE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="BTTMLINE" />
  <meta property="og:locale" content="nl_BE" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#050706" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <div style="position:relative; min-height:100vh; isolation:isolate">

    <!-- Background motion: drifting grid + two green glows + vignette -->
    <div class="bg-layer" style="position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden" aria-hidden="true">
      <div style="position:absolute; inset:-20% -20% -20% -20%; background-image:linear-gradient(rgba(0,120,97,.16) 1px, transparent 1px), linear-gradient(90deg, rgba(0,120,97,.16) 1px, transparent 1px); background-size:72px 72px; animation:drift 14s linear infinite; mask-image:radial-gradient(120% 90% at 50% 0%, #000 0%, transparent 78%); -webkit-mask-image:radial-gradient(120% 90% at 50% 0%, #000 0%, transparent 78%)"></div>
      <div style="position:absolute; top:-30vh; left:-10vw; width:80vw; height:80vh; border-radius:50%; background:radial-gradient(circle, rgba(0,120,97,.34) 0%, rgba(0,120,97,0) 65%); filter:blur(30px); animation:glowA 26s ease-in-out infinite"></div>
      <div style="position:absolute; bottom:-40vh; right:-15vw; width:70vw; height:80vh; border-radius:50%; background:radial-gradient(circle, rgba(0,120,97,.22) 0%, rgba(0,120,97,0) 65%); filter:blur(40px); animation:glowB 34s ease-in-out infinite"></div>
      <div style="position:absolute; inset:0; background:radial-gradient(100% 60% at 50% 0%, rgba(5,7,6,0) 0%, #050706 100%)"></div>
    </div>

    <!-- Cursor spotlight grid (revealed on mouse move over desktop) -->
    <div class="cursor-grid" id="cursor-grid" style="position:fixed; inset:0; z-index:60; pointer-events:none; opacity:0; transition:opacity .5s ease; background-image:linear-gradient(rgba(43,216,168,.55) 1px, transparent 1px), linear-gradient(90deg, rgba(43,216,168,.55) 1px, transparent 1px); background-size:36px 36px; mask-image:radial-gradient(190px circle at var(--gx,50%) var(--gy,50%), rgba(0,0,0,.9) 0%, rgba(0,0,0,.35) 45%, transparent 72%); -webkit-mask-image:radial-gradient(190px circle at var(--gx,50%) var(--gy,50%), rgba(0,0,0,.9) 0%, rgba(0,0,0,.35) 45%, transparent 72%)" aria-hidden="true"></div>

    <!-- Cursor pulse: shown over buttons/links/logos instead of the grid -->
    <div id="cursor-pulse" aria-hidden="true"><span></span></div>

    <Header current={current} />

    <main style="position:relative; z-index:2; padding-top:64px">
      <slot />
    </main>

    <Footer />
  </div>

  <script>
    // Mobile menu toggle
    const toggle = document.querySelector('.nav-toggle');
    const body = document.body;
    if (toggle) {
      const setOpen = (open) => {
        body.classList.toggle('menu-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
      };
      toggle.addEventListener('click', () => setOpen(!body.classList.contains('menu-open')));
      document.querySelectorAll('.mobile-menu a').forEach((a) =>
        a.addEventListener('click', () => setOpen(false))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
    }

    // Cursor spotlight grid — write CSS vars straight to the element so the
    // page never re-renders on mouse move. Disabled for touch / reduced-motion.
    const grid = document.getElementById('cursor-grid');
    const pulse = document.getElementById('cursor-pulse');
    const heroEl = document.querySelector('.hero-outer');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (grid && fine && !reduce) {
      window.addEventListener('mousemove', (e) => {
        grid.style.setProperty('--gx', e.clientX + 'px');
        grid.style.setProperty('--gy', e.clientY + 'px');
        const onInteractive = !!(e.target instanceof Element && e.target.closest('a, button'));
        if (pulse) {
          pulse.style.transform = 'translate3d(' + e.clientX + 'px,' + e.clientY + 'px,0)';
          pulse.style.opacity = onInteractive ? '1' : '0';
        }
        if (onInteractive) {
          // fade the grid out, show the pulse under the cursor
          grid.style.opacity = '0';
        } else {
          // only reveal the cursor grid once you're below the hero (which has its own grid)
          const heroBottom = heroEl ? heroEl.getBoundingClientRect().bottom : 0;
          grid.style.opacity = e.clientY > heroBottom ? '1' : '0';
        }
      }, { passive: true });
      document.addEventListener('mouseleave', () => {
        grid.style.opacity = '0';
        if (pulse) pulse.style.opacity = '0';
      });
    }

  </script>

  <!-- ElevenLabs Convai-widget (Alex) -->
  <elevenlabs-convai agent-id="agent_5801kyv9memxfytb1t3wcbasvgdz"></elevenlabs-convai>
  <script src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript" is:inline></script>
</body>
</html>
