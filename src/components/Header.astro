---
// Fixed site header, shared across every route.
// `current` marks the active page for nav highlighting.
const { current } = Astro.props;

const links = [
  { href: '/diensten', label: 'Diensten' },
  { href: '/cases', label: 'Cases' },
  { href: '/inzichten', label: 'Inzichten' },
  { href: '/team', label: 'Team' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href) => current === href;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" aria-label="BTTMLINE home" style="display:flex; align-items:center">
      <img class="logo-img logo-img-dark" src="/assets/bttmline-logo-white.png" alt="BTTMLINE" width="500" height="63" style="height:22px; width:auto" />
      <img class="logo-img logo-img-light" src="/assets/bttmline-logo-dark.png" alt="BTTMLINE" width="500" height="63" style="height:22px; width:auto" />
    </a>

    <nav class="nav-links" aria-label="Hoofdnavigatie">
      {links.map((l) => (
        <a
          class="nav-link"
          href={l.href}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
        >{l.label}</a>
      ))}
      <a
        class="btn-cta header-cta-desktop"
        href="/contact"
        style="background:#007861; color:#FFFFFF; font-family:var(--mono); font-size:12px; letter-spacing:.06em; padding:11px 18px; border:1px solid #00A583"
      >Gratis AI Automation Audit</a>
    </nav>

    <div class="header-actions">
      <a
        class="btn-cta header-cta-mobile"
        href="/contact"
        style="display:none; background:#007861; color:#FFFFFF; font-family:var(--mono); font-size:11px; letter-spacing:.04em; padding:10px 14px; border:1px solid #00A583"
      >Gratis audit</a>
      <button class="theme-toggle" type="button" aria-label="Wissel tussen licht en donker" aria-pressed="false" title="Licht / donker">
        <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.4M12 19v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.6 12h2.4M19 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/></svg>
        <svg class="ico-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 14.4A8 8 0 0 1 9.6 4a1 1 0 0 0-1.3-1.3A9.5 9.5 0 1 0 21.3 15.7 1 1 0 0 0 20 14.4Z"/></svg>
      </button>
      <button class="nav-toggle" type="button" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-menu">
        <span></span>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-menu" id="mobile-menu" aria-label="Mobiele navigatie">
  <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
  {links.map((l) => (
    <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
  ))}
  <a class="btn-cta" href="/contact" style="background:#007861; color:#FFFFFF; font-family:var(--mono); font-size:13px; padding:16px 18px; border:1px solid #00A583">Gratis AI Automation Audit</a>
</nav>

<style>
  /* Show the compact CTA only on phones, where the desktop nav is hidden. */
  @media (max-width: 768px) {
    .header-cta-mobile { display: inline-block !important; }
  }
</style>
