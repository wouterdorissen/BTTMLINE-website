---
// Shared site footer.
---
<footer style="position:relative; z-index:2; border-top:1px solid rgba(var(--ov),.08); background:var(--footer)">
  <div class="sec" style="max-width:1280px; margin:0 auto; padding:70px 32px 40px">
    <div class="footer-grid" style="display:grid; grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(0,1fr)); gap:44px">
      <div>
        <img class="logo-img logo-img-dark" src="/assets/bttmline-logo-white.png" alt="BTTMLINE" width="500" height="63" style="height:26px; width:auto" />
        <img class="logo-img logo-img-light" src="/assets/bttmline-logo-dark.png" alt="BTTMLINE" width="500" height="63" style="height:26px; width:auto" />
        <p style="font-size:16px; line-height:1.6; color:rgba(var(--fg),.6); margin:16px 0 0; max-width:40ch">Wij zorgen dat bedrijven AI en automatisering omzetten in echte vooruitgang, in plaats van stil te staan uit twijfel of te verdwalen in de hype.</p>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:rgba(var(--fg),.4); margin-bottom:18px">Site</div>
        <div style="display:grid; gap:10px">
          <a href="/diensten" style="font-size:15px; color:rgba(var(--fg),.72)">Diensten en trajecten</a>
          <a href="/cases" style="font-size:15px; color:rgba(var(--fg),.72)">Cases</a>
          <a href="/inzichten" style="font-size:15px; color:rgba(var(--fg),.72)">Inzichten</a>
          <a href="/team" style="font-size:15px; color:rgba(var(--fg),.72)">Team</a>
          <a href="/faq" style="font-size:15px; color:rgba(var(--fg),.72)">FAQ</a>
          <a href="/contact" style="font-size:15px; color:rgba(var(--fg),.72)">Contact</a>
        </div>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:rgba(var(--fg),.4); margin-bottom:18px">Contact</div>
        <div style="display:grid; gap:10px">
          <a href="mailto:info@bttmline.be" style="font-size:15px">info@bttmline.be</a>
          <a href="tel:+32485769705" style="font-size:15px">+32 485 76 97 05</a>
          <a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x47c0de42887e7c4f:0xb563236af3566e64?sa=X&amp;ved=1t:8290&amp;ictx=111" target="_blank" rel="noopener noreferrer" style="font-size:15px; color:rgba(var(--fg),.6)">Caetsbeekstraat 12, 3740 Bilzen-Hoeselt, België</a>
          <a href="https://www.linkedin.com/company/bttmline/" target="_blank" rel="noopener noreferrer" style="font-size:15px">LinkedIn</a>
        </div>
      </div>
    </div>
    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-top:56px; padding-top:22px; border-top:1px solid rgba(var(--ov),.07)">
      <span style="font-family:var(--mono); font-size:12px; color:rgba(var(--fg),.35)">© 2026 BTTMLINE · <a href="/privacy" style="color:rgba(var(--fg),.5)">Privacybeleid</a></span>
      <span style="font-family:var(--mono); font-size:12px; color:rgba(var(--fg),.35)">Automatisering en AI voor Vlaamse bedrijven</span>
    </div>
  </div>
</footer>
