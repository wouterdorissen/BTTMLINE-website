---
// Shared site footer.
---
<footer style="position:relative; z-index:2; border-top:1px solid rgba(255,255,255,.08); background:#040605">
  <div class="sec" style="max-width:1280px; margin:0 auto; padding:70px 32px 40px">
    <div class="footer-grid" style="display:grid; grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(0,1fr)); gap:44px">
      <div>
        <img src="/assets/bttmline-logo-white.png" alt="BTTMLINE" width="500" height="63" style="height:26px; width:auto; display:block" />
        <p style="font-size:16px; line-height:1.6; color:rgba(242,245,243,.6); margin:16px 0 0; max-width:40ch">Wij zorgen dat bedrijven AI en automatisering omzetten in echte vooruitgang, in plaats van stil te staan uit twijfel of te verdwalen in de hype.</p>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.4); margin-bottom:18px">Site</div>
        <div style="display:grid; gap:10px">
          <a href="/diensten" style="font-size:15px; color:rgba(242,245,243,.72)">Diensten en trajecten</a>
          <a href="/cases" style="font-size:15px; color:rgba(242,245,243,.72)">Cases</a>
          <a href="/inzichten" style="font-size:15px; color:rgba(242,245,243,.72)">Inzichten</a>
          <a href="/team" style="font-size:15px; color:rgba(242,245,243,.72)">Team</a>
          <a href="/contact" style="font-size:15px; color:rgba(242,245,243,.72)">Contact</a>
        </div>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.4); margin-bottom:18px">Contact</div>
        <div style="display:grid; gap:10px">
          <a href="mailto:hallo@bttmline.be" style="font-size:15px">hallo@bttmline.be</a>
          <span style="font-size:15px; color:rgba(242,245,243,.6)">Hasselt, België</span>
          <a href="https://www.linkedin.com/" style="font-size:15px">LinkedIn</a>
        </div>
      </div>
    </div>
    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-top:56px; padding-top:22px; border-top:1px solid rgba(255,255,255,.07)">
      <span style="font-family:var(--mono); font-size:11px; color:rgba(242,245,243,.35)">© 2026 BTTMLINE</span>
      <span style="font-family:var(--mono); font-size:11px; color:rgba(242,245,243,.35)">Automatisering en AI voor Vlaamse bedrijven</span>
    </div>
  </div>
</footer>
