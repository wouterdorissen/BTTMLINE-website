---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('inzichten', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base
  current="/inzichten"
  title="Inzichten — BTTMLINE"
  description="Wij delen wat we weten. Webinars met Verse Vlaai en korte inzichten over AI en automatisering, in mensentaal en zonder hype."
>

  <section class="sec sec-hero" style="max-width:1280px; margin:0 auto; padding:110px 32px 70px">
    <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:#2BD8A8; margin-bottom:24px">Inzichten</div>
    <h1 style="font-family:Archivo; font-weight:600; font-size:clamp(40px,6vw,88px); line-height:1; letter-spacing:-.04em; margin:0">Wij delen wat we weten.</h1>
    <p style="font-size:18px; line-height:1.65; color:rgba(242,245,243,.66); margin:36px 0 0; max-width:60ch; text-wrap:pretty">Iedereen roept dat AI alles verandert. Wij tonen hoe het echt werkt, in mensentaal, zonder hype. Volg onze webinars en lees onze inzichten.</p>
  </section>

  <section style="border-top:1px solid rgba(255,255,255,.07)">
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:80px 32px">
      <div style="border:1px solid rgba(43,216,168,.28); background:linear-gradient(180deg, rgba(0,120,97,.14) 0%, rgba(8,11,10,1) 60%); padding:44px 40px">
        <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:#2BD8A8; margin-bottom:20px">Webinarreeks</div>
        <h2 style="font-family:Archivo; font-weight:600; font-size:clamp(28px,3.4vw,46px); line-height:1.05; letter-spacing:-.03em; margin:0 0 18px; max-width:28ch">De AI-webinarreeks van BTTMLINE en Verse Vlaai</h2>
        <p style="font-size:17px; line-height:1.6; color:rgba(242,245,243,.68); margin:0 0 36px; max-width:56ch">Drie sessies, drie momenten in je AI-traject. Gratis, praktisch, met live demo. Schrijf je in voor de hele reeks.</p>
        <div style="display:grid; gap:1px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.1); margin-bottom:36px">
          <div class="webinar-row" style="background:#080B0A; padding:24px 26px; display:grid; grid-template-columns:180px minmax(0,1fr) auto; gap:24px; align-items:center">
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#2BD8A8">24 sep, 10:30</div>
            <div>
              <div style="font-family:Archivo; font-weight:600; font-size:19px; letter-spacing:-.02em">Intro tot AI</div>
              <div style="font-size:14px; color:rgba(242,245,243,.55); margin-top:4px">Voor wie nog niet gestart is.</div>
            </div>
            <div class="webinar-index" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(242,245,243,.4)">SESSIE 01</div>
          </div>
          <div class="webinar-row" style="background:#080B0A; padding:24px 26px; display:grid; grid-template-columns:180px minmax(0,1fr) auto; gap:24px; align-items:center">
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#2BD8A8">22 okt, 10:30</div>
            <div>
              <div style="font-family:Archivo; font-weight:600; font-size:19px; letter-spacing:-.02em">Definiëren van een AI-project in je bedrijf</div>
              <div style="font-size:14px; color:rgba(242,245,243,.55); margin-top:4px">Voor wie ideeën heeft maar vastzit.</div>
            </div>
            <div class="webinar-index" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(242,245,243,.4)">SESSIE 02</div>
          </div>
          <div class="webinar-row" style="background:#080B0A; padding:24px 26px; display:grid; grid-template-columns:180px minmax(0,1fr) auto; gap:24px; align-items:center">
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#2BD8A8">26 nov, 10:30</div>
            <div>
              <div style="font-family:Archivo; font-weight:600; font-size:19px; letter-spacing:-.02em">AI-cases en learnings uit de praktijk</div>
              <div style="font-size:14px; color:rgba(242,245,243,.55); margin-top:4px">Voor wie al iets probeerde.</div>
            </div>
            <div class="webinar-index" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(242,245,243,.4)">SESSIE 03</div>
          </div>
        </div>
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:20px">
          <a class="btn-cta" href="/contact" style="display:inline-block; background:#007861; color:#FFFFFF; font-family:'JetBrains Mono',monospace; font-size:13px; padding:16px 24px; border:1px solid #00A583">Schrijf je in voor de reeks</a>
          <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(242,245,243,.42)">Na afloop: opnames en downloadbaar materiaal per sessie.</span>
        </div>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid rgba(255,255,255,.07)">
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:80px 32px">
      <div style="display:flex; justify-content:space-between; align-items:end; gap:24px; flex-wrap:wrap; margin-bottom:36px">
        <h2 style="font-family:Archivo; font-weight:600; font-size:clamp(28px,3.4vw,44px); letter-spacing:-.035em; margin:0">Blog en korte inzichten</h2>
        <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:rgba(242,245,243,.42)">Demystifying AI · Praktijk · Niet alles is AI</div>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:20px">
        {posts.map((post) => (
          <a class="card" href={`/inzichten/${post.id}`} style="display:block; border:1px solid rgba(255,255,255,.1); background:#080B0A; color:#F2F5F3">
            <div style="border-bottom:1px solid rgba(255,255,255,.1); height:150px; background:repeating-linear-gradient(135deg, rgba(255,255,255,.035) 0 7px, transparent 7px 14px); display:flex; align-items:end; padding:16px">
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; color:rgba(242,245,243,.4)">[ beeld ]</span>
            </div>
            <div style="padding:26px">
              <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.14em; color:#2BD8A8; text-transform:uppercase">{post.data.category}</div>
              <div style="font-family:Archivo; font-weight:600; font-size:21px; line-height:1.24; letter-spacing:-.02em; margin-top:14px">{post.data.title}</div>
              <p style="font-size:15px; line-height:1.55; color:rgba(242,245,243,.6); margin:10px 0 0">{post.data.summary}</p>
              <span style="display:inline-block; margin-top:18px; font-family:'JetBrains Mono',monospace; font-size:12px; color:#2BD8A8">Lees →</span>
            </div>
          </a>
        ))}
        <div style="border:1px dashed rgba(255,255,255,.14); background:repeating-linear-gradient(135deg, rgba(255,255,255,.025) 0 7px, transparent 7px 14px); display:flex; align-items:center; justify-content:center; padding:40px; text-align:center">
          <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(242,245,243,.42); line-height:1.7">[ ruimte voor korte video's<br />van 2 minuten ]</div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:100px 32px; text-align:center">
      <h2 style="font-family:Archivo; font-weight:600; font-size:clamp(30px,4vw,52px); letter-spacing:-.035em; margin:0 0 28px">Vragen na het lezen of kijken?</h2>
      <a class="btn-cta" href="/contact" style="display:inline-block; background:#007861; color:#FFFFFF; font-family:'JetBrains Mono',monospace; font-size:13px; padding:17px 26px; border:1px solid #00A583">Gratis AI Automation Audit</a>
    </div>
  </section>

</Base>
