---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden — BTTMLINE" description="Deze pagina bestaat niet of is verplaatst.">
  <section class="sec sec-hero" style="max-width:1280px; margin:0 auto; padding:150px 32px 130px; text-align:center">
    <div style="font-family:'Geist',sans-serif; font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:var(--accent); margin-bottom:24px">Fout 404</div>
    <h1 style="font-family:Geist; font-weight:600; font-size:clamp(34px,4.4vw,64px); line-height:1.03; letter-spacing:-.04em; margin:0">Deze pagina bestaat niet.</h1>
    <p style="font-size:18px; line-height:1.6; color:rgba(var(--fg),.66); margin:28px auto 40px; max-width:46ch">Misschien is de link verouderd of verkeerd getypt. Geen probleem, we brengen je terug op weg.</p>
    <div style="display:flex; flex-wrap:wrap; gap:14px; justify-content:center">
      <a class="btn-cta" href="/" style="display:inline-block; background:#007861; color:#FFFFFF; font-family:'Geist',sans-serif; font-size:13px; padding:16px 26px; border:1px solid #00A583">Naar de homepagina</a>
      <a class="btn-ghost" href="/contact" style="display:inline-block; color:var(--text); font-family:'Geist',sans-serif; font-size:13px; padding:16px 26px; border:1px solid rgba(var(--ov),.16)">Contact</a>
    </div>
  </section>
</Base>
