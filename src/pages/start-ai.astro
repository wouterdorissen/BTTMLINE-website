---
import Base from '../layouts/Base.astro';

const watJeLeert = [
  'Inzicht in je datalandschap en waar de kansen echt zitten.',
  'Concrete AI- en automatiseringsopportuniteiten, vertaald naar jouw processen.',
  'Een realistisch beeld van de kosten en de verwachte opbrengst.',
  'Een concreet startpunt, geen vrijblijvend rapport.',
];
---
<Base
  title="Start AI — officiële partner | BTTMLINE"
  description="BTTMLINE is een officiële Start AI-partner. Start AI is een gesubsidieerd begeleidingstraject van het Industriepartnerschap (Sirris en Agoria) met steun van VLAIO, voor Vlaamse kmo's die met data en AI aan de slag willen."
>

  <section class="sec sec-hero" style="max-width:1280px; margin:0 auto; padding:110px 32px 50px">
    <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.2em; text-transform:uppercase; color:var(--accent); margin-bottom:24px">Start AI · Officiële partner</div>
    <h1 style="font-family:Geist; font-weight:600; font-size:clamp(34px,4.4vw,64px); line-height:1.03; letter-spacing:-.04em; margin:0; max-width:20ch; text-wrap:balance">Start AI: van hype naar een concreet plan voor jouw bedrijf.</h1>
    <p style="font-size:18px; line-height:1.65; color:rgba(var(--fg),.66); margin:32px 0 0; max-width:62ch; text-wrap:pretty">Start AI is een gesubsidieerd begeleidingstraject voor Vlaamse kmo's die met data en AI aan de slag willen, maar niet weten waar te beginnen. BTTMLINE is een officiële Start AI-partner en voert de begeleiding uit.</p>
    <div style="display:flex; flex-wrap:wrap; gap:14px; margin-top:32px">
      <a class="btn-cta" href="/contact" style="background:#007861; color:#FFFFFF; font-family:'Geist',sans-serif; letter-spacing:.04em; padding:16px 26px; border:1px solid #00A583">Vraag Start AI aan</a>
      <a class="btn-ghost" href="https://www.agoria.be/nl/diensten/expertise/digitalisering/artificiele-intelligentie/start-ai-haal-meer-uit-uw-data-met-artificiele-intelligentie" target="_blank" rel="noopener noreferrer" style="color:var(--text); font-family:'Geist',sans-serif; letter-spacing:.04em; padding:16px 26px; border:1px solid rgba(var(--ov),.16)">Officiële info</a>
    </div>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec stack-2" style="max-width:1280px; margin:0 auto; padding:80px 32px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:64px; align-items:start">
      <div>
        <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); margin-bottom:20px">Wat is Start AI?</div>
        <h2 style="font-family:Geist; font-weight:600; font-size:clamp(26px,3vw,40px); line-height:1.08; letter-spacing:-.03em; margin:0">Een driedaags traject, in je eigen bedrijfscontext.</h2>
      </div>
      <div>
        <p style="font-size:18px; line-height:1.65; color:rgba(var(--fg),.7); margin:0; text-wrap:pretty">Start AI is een initiatief van het Industriepartnerschap, onder leiding van Sirris en Agoria, met steun van VLAIO en Europa. Tijdens een begeleiding van drie dagen werkt een AI- en data-expert samen met jouw team aan een praktische oefening op basis van je eigen processen, uitdagingen en kansen.</p>
        <p style="font-size:17px; line-height:1.62; color:rgba(var(--fg),.6); margin:22px 0 0; text-wrap:pretty">Je leert de mogelijkheden van je data kennen, ziet waar AI en automatisering je processen efficiënter maken, en krijgt een realistisch beeld van de return op zo'n investering.</p>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:80px 32px">
      <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); margin-bottom:20px">Wat je eruit haalt</div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:1px; background:rgba(var(--ov),.08); border:1px solid rgba(var(--ov),.08)">
        {watJeLeert.map((w, i) => (
          <div style="background:var(--panel); padding:32px 28px">
            <div style="font-family:'Geist',sans-serif; font-size:14px; color:var(--accent); letter-spacing:.14em">{String(i + 1).padStart(2, '0')}</div>
            <div style="font-size:16px; line-height:1.55; margin-top:14px; color:rgba(var(--fg),.82)">{w}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec stack-2" style="max-width:1280px; margin:0 auto; padding:80px 32px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:64px; align-items:start">
      <div>
        <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); margin-bottom:20px">Waarom met BTTMLINE</div>
        <h2 style="font-family:Geist; font-weight:600; font-size:clamp(26px,3vw,40px); line-height:1.08; letter-spacing:-.03em; margin:0">Officiële partner, en de mensen die het daarna ook bouwen.</h2>
      </div>
      <div>
        <p style="font-size:18px; line-height:1.65; color:rgba(var(--fg),.7); margin:0; text-wrap:pretty">Als officiële Start AI-partner voeren wij de begeleiding uit. Je werkt met senior software engineers die al ver voor de AI-hype grote, complexe systemen bouwden, niet met een verkoper.</p>
        <p style="font-size:17px; line-height:1.62; color:rgba(var(--fg),.6); margin:22px 0 0; text-wrap:pretty">We blijven nuchter: niet alles is AI. We kijken naar je proces, zeggen eerlijk wat wel en niet loont, en kunnen na Start AI ook echt bouwen wat werkt.</p>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:80px 32px">
      <div style="border:1px solid rgba(43,216,168,.28); background:linear-gradient(180deg, rgba(0,120,97,.12) 0%, var(--panel) 60%); padding:44px 40px">
        <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); margin-bottom:20px">Kostprijs en subsidie</div>
        <p style="font-size:18px; line-height:1.65; color:rgba(var(--fg),.72); margin:0; max-width:70ch; text-wrap:pretty">Dankzij de steun van VLAIO en Europa is Start AI sterk gesubsidieerd, met een beperkte eigen bijdrage. De exacte bedragen en de eerstvolgende inschrijfperiode wisselen per oproep. Je vindt ze bij VLAIO en Agoria, of vraag het ons gewoon, dan bekijken we samen of je in aanmerking komt.</p>
        <div style="display:flex; flex-wrap:wrap; gap:20px; margin-top:24px">
          <a href="https://www.vlaio.be/nl/begeleiding-advies/digitalisering/artificiele-intelligentie" target="_blank" rel="noopener noreferrer" style="font-family:'Geist',sans-serif; font-size:14px; color:var(--accent)">VLAIO over AI →</a>
          <a href="https://www.agoria.be/nl/diensten/expertise/digitalisering/artificiele-intelligentie/start-ai-haal-meer-uit-uw-data-met-artificiele-intelligentie" target="_blank" rel="noopener noreferrer" style="font-family:'Geist',sans-serif; font-size:14px; color:var(--accent)">Agoria over Start AI →</a>
        </div>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:100px 32px; text-align:center">
      <h2 style="font-family:Geist; font-weight:600; font-size:clamp(30px,4vw,52px); letter-spacing:-.035em; margin:0 0 28px; text-wrap:balance">Klaar om te starten met AI?</h2>
      <a class="btn-cta" href="/contact" style="display:inline-block; background:#007861; color:#FFFFFF; font-family:'Geist',sans-serif; padding:17px 26px; border:1px solid #00A583">Vraag Start AI aan</a>
    </div>
  </section>

</Base>
