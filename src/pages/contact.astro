---
import Base from '../layouts/Base.astro';
---
<Base
  current="/contact"
  title="Contact — BTTMLINE"
  description="Laten we praten. 30 minuten, en je weet meteen of het zin heeft. Gratis informatie, zonder verplichting. hallo@bttmline.be — Hasselt, België."
>

  <section class="sec sec-hero" style="max-width:1280px; margin:0 auto; padding:110px 32px 70px">
    <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:#2BD8A8; margin-bottom:24px">Contact</div>
    <h1 style="font-family:Archivo; font-weight:600; font-size:clamp(48px,8vw,120px); line-height:.95; letter-spacing:-.045em; margin:0">Laten we praten.</h1>
    <p style="font-size:19px; line-height:1.6; color:rgba(242,245,243,.68); margin:32px 0 0; max-width:46ch">30 minuten. Je weet meteen of het zin heeft. Gratis informatie, zonder verplichting.</p>
  </section>

  <section style="border-top:1px solid rgba(255,255,255,.07)">
    <div class="sec stack-2" style="max-width:1280px; margin:0 auto; padding:70px 32px; display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:20px">
      <div style="border:1px solid rgba(43,216,168,.28); background:#080B0A; padding:36px 34px">
        <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:#2BD8A8; margin-bottom:24px">Kies een moment</div>
        <div style="border:1px dashed rgba(255,255,255,.16); background:repeating-linear-gradient(135deg, rgba(255,255,255,.025) 0 7px, transparent 7px 14px); min-height:380px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; text-align:center; padding:30px">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:rgba(242,245,243,.55)">[ agenda-widget: 30 minuten ]</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(242,245,243,.35); max-width:34ch; line-height:1.7">Boekingslink aan te leveren door BTTMLINE. Bij het boeken vragen we genoeg info om te kwalificeren.</div>
        </div>
      </div>
      <div style="display:grid; gap:20px; align-content:start">
        <div style="border:1px solid rgba(255,255,255,.1); background:#080B0A; padding:32px 30px; display:grid; gap:22px">
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.4)">E-mail</div>
            <a href="mailto:hallo@bttmline.be" style="font-size:17px; display:inline-block; margin-top:6px">hallo@bttmline.be</a>
          </div>
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.4)">Telefoon</div>
            <div style="font-size:17px; margin-top:6px; color:rgba(242,245,243,.85)">[ nummer aan te leveren ]</div>
          </div>
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.4)">Adres</div>
            <div style="font-size:17px; margin-top:6px; color:rgba(242,245,243,.85)">Hasselt, België</div>
          </div>
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.4)">LinkedIn</div>
            <a href="https://www.linkedin.com/" style="font-size:17px; display:inline-block; margin-top:6px">BTTMLINE op LinkedIn</a>
          </div>
        </div>
        <div style="border:1px solid rgba(255,255,255,.1); background:#080B0A; padding:32px 30px">
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.4); margin-bottom:20px">Wat je overhoudt aan het gesprek</div>
          <div style="display:grid; gap:14px">
            <div style="display:grid; grid-template-columns:20px 1fr; gap:12px; align-items:start"><span style="color:#2BD8A8; font-family:'JetBrains Mono',monospace; font-size:13px">+</span><span style="font-size:15px; line-height:1.5">Een realistisch beeld van wat haalbaar is, en hoe snel.</span></div>
            <div style="display:grid; grid-template-columns:20px 1fr; gap:12px; align-items:start"><span style="color:#2BD8A8; font-family:'JetBrains Mono',monospace; font-size:13px">+</span><span style="font-size:15px; line-height:1.5">Een duidelijke volgende stap.</span></div>
            <div style="display:grid; grid-template-columns:20px 1fr; gap:12px; align-items:start"><span style="color:#2BD8A8; font-family:'JetBrains Mono',monospace; font-size:13px">+</span><span style="font-size:15px; line-height:1.5">Antwoorden op je concrete vragen.</span></div>
            <div style="display:grid; grid-template-columns:20px 1fr; gap:12px; align-items:start"><span style="color:#2BD8A8; font-family:'JetBrains Mono',monospace; font-size:13px">+</span><span style="font-size:15px; line-height:1.5">Gratis informatie, zonder verplichting.</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid rgba(255,255,255,.07)">
    <div class="sec stack-2" style="max-width:1280px; margin:0 auto; padding:80px 32px; display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:56px; align-items:start">
      <div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:#2BD8A8; margin-bottom:20px">Of schrijf ons</div>
        <h2 style="font-family:Archivo; font-weight:600; font-size:clamp(28px,3.4vw,46px); line-height:1.05; letter-spacing:-.03em; margin:0 0 18px; text-wrap:balance">Liever eerst even schrijven?</h2>
        <p style="font-size:17px; line-height:1.6; color:rgba(242,245,243,.66); margin:0; max-width:44ch">Vertel kort waar je mee zit. We lezen alles zelf en antwoorden binnen één werkdag. Geen automatische funnel, gewoon een mens.</p>
      </div>

      <form id="contact-form" method="POST" action="mailto:hallo@bttmline.be" enctype="text/plain" style="border:1px solid rgba(255,255,255,.1); background:#080B0A; padding:34px 32px; display:grid; gap:22px">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:22px" class="form-row">
          <label style="display:grid; gap:8px">
            <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.5)">Naam *</span>
            <input name="naam" type="text" required autocomplete="name" class="field" placeholder="Je naam" />
          </label>
          <label style="display:grid; gap:8px">
            <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.5)">Bedrijf</span>
            <input name="bedrijf" type="text" autocomplete="organization" class="field" placeholder="Bedrijfsnaam" />
          </label>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:22px" class="form-row">
          <label style="display:grid; gap:8px">
            <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.5)">E-mail *</span>
            <input name="email" type="email" required autocomplete="email" class="field" placeholder="jij@bedrijf.be" />
          </label>
          <label style="display:grid; gap:8px">
            <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.5)">Telefoon</span>
            <input name="telefoon" type="tel" autocomplete="tel" class="field" placeholder="Optioneel" />
          </label>
        </div>
        <label style="display:grid; gap:8px">
          <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:rgba(242,245,243,.5)">Waar kunnen we mee helpen? *</span>
          <textarea name="bericht" required rows="5" class="field" placeholder="Vertel kort over je proces of vraag."></textarea>
        </label>
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:18px">
          <button type="submit" class="btn-cta" style="background:#007861; color:#FFFFFF; font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:.04em; padding:15px 26px; border:1px solid #00A583; cursor:pointer">Verstuur bericht</button>
          <span id="form-status" role="status" aria-live="polite" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(242,245,243,.5)"></span>
        </div>
      </form>
    </div>
  </section>

  <style>
    .field {
      width: 100%;
      background: #050706;
      border: 1px solid rgba(255, 255, 255, .14);
      color: #F2F5F3;
      font-family: Archivo, Helvetica, Arial, sans-serif;
      font-size: 16px;
      padding: 13px 14px;
      outline: none;
      transition: border-color .2s ease, box-shadow .2s ease;
    }
    .field::placeholder { color: rgba(242, 245, 243, .32); }
    .field:focus {
      border-color: rgba(43, 216, 168, .6);
      box-shadow: 0 0 0 3px rgba(0, 120, 97, .18);
    }
    textarea.field { resize: vertical; min-height: 120px; line-height: 1.5; }
    @media (max-width: 560px) {
      #contact-form .form-row { grid-template-columns: 1fr !important; }
    }
  </style>

  <script>
    // Zero-backend contact form: compose a mailto so it works on any static
    // host. Swap the fetch block below for a Formspree/HubSpot endpoint when
    // BTTMLINE has one.
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    if (form && status) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const naam = (data.get('naam') || '').toString().trim();
        const bedrijf = (data.get('bedrijf') || '').toString().trim();
        const email = (data.get('email') || '').toString().trim();
        const telefoon = (data.get('telefoon') || '').toString().trim();
        const bericht = (data.get('bericht') || '').toString().trim();

        const subject = `Audit-aanvraag: ${naam}${bedrijf ? ' (' + bedrijf + ')' : ''}`;
        const body =
          `Naam: ${naam}\n` +
          `Bedrijf: ${bedrijf || '-'}\n` +
          `E-mail: ${email}\n` +
          `Telefoon: ${telefoon || '-'}\n\n` +
          `Bericht:\n${bericht}\n`;

        window.location.href =
          `mailto:hallo@bttmline.be?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        status.textContent = 'Je mailprogramma opent met je bericht — druk op verzenden.';
        status.style.color = '#2BD8A8';
      });
    }
  </script>

</Base>
