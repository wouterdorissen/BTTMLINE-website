---
import Base from '../../layouts/Base.astro';
import { cases, caseOrder } from '../../data/cases.js';
---
<Base
  current="/cases"
  title="Cases — BTTMLINE"
  description="Echte projecten, echte resultaten. Van transportdocumentatie die vanzelf verloopt tot AI-agents op inkomende orders. Soms met AI, vaak met slimme automatisering."
>

  <section class="sec sec-hero" style="max-width:1280px; margin:0 auto; padding:110px 32px 60px">
    <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.2em; text-transform:uppercase; color:var(--accent); margin-bottom:24px">Cases</div>
    <h1 style="font-family:Geist; font-weight:600; font-size:clamp(34px,4.4vw,64px); line-height:1.03; letter-spacing:-.04em; margin:0">Echte projecten. Echte resultaten.</h1>
    <p style="font-size:18px; line-height:1.65; color:rgba(var(--fg),.66); margin:36px 0 0; max-width:64ch; text-wrap:pretty">Geen theorie. Dit is wat we bouwden, met welke systemen het koppelt, en wat het opleverde. Van diepe AI-automatisering tot slimme oplossingen zonder één lijn AI.</p>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:70px 32px 90px">
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(340px,1fr)); gap:20px">
        {caseOrder.map((slug) => {
          const c = cases[slug];
          return (
            <a class="card" href={`/cases/${slug}`} style="display:flex; flex-direction:column; border:1px solid rgba(var(--ov),.1); background:var(--panel); color:var(--text); padding:34px 32px">
              <div style="height:34px; margin-bottom:26px; display:flex; align-items:center">
                {c.logo
                  ? <img class="case-logo" src={c.logo} alt={c.naam} style="height:30px" />
                  : <span style="font-family:Geist; font-weight:600; font-size:20px; letter-spacing:-.02em">{c.naam}</span>}
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px">
                {c.tags.map((t) => (
                  <span style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.04em; color:rgba(var(--fg),.55); border:1px solid rgba(var(--ov),.12); padding:4px 10px">{t}</span>
                ))}
              </div>
              <div style="font-family:Geist; font-weight:600; font-size:22px; line-height:1.24; letter-spacing:-.02em">{c.title}</div>
              <p style="font-size:15px; line-height:1.55; color:rgba(var(--fg),.6); margin:14px 0 24px">{c.subtitle}</p>
              <div style="margin-top:auto; padding-top:20px; border-top:1px solid rgba(var(--ov),.1); display:flex; justify-content:space-between; align-items:center; gap:16px">
                <span style="font-family:Geist; font-weight:600; font-size:15px; color:var(--accent); line-height:1.3">{c.result}</span>
                <span style="font-family:'Geist',sans-serif; font-size:14px; color:var(--accent)">Lees →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec" style="max-width:1280px; margin:0 auto; padding:100px 32px; text-align:center">
      <h2 style="font-family:Geist; font-weight:600; font-size:clamp(30px,4vw,52px); letter-spacing:-.035em; margin:0 0 28px; text-wrap:balance">Ben jij de volgende?</h2>
      <a class="btn-cta" href="/contact" style="display:inline-block; background:#007861; color:#FFFFFF; font-family:'Geist',sans-serif; padding:17px 26px; border:1px solid #00A583">Kosteloze AI Automation Audit</a>
    </div>
  </section>

</Base>
