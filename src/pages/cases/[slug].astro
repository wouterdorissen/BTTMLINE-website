---
import Base from '../../layouts/Base.astro';
import { cases, caseOrder } from '../../data/cases.js';

export function getStaticPaths() {
  return caseOrder.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const c = cases[slug];
const idx = caseOrder.indexOf(slug);
const next = caseOrder[(idx + 1) % caseOrder.length];
const nextCase = cases[next];
---
<Base current="/cases" title={`${c.naam}: ${c.title} — BTTMLINE`} description={c.subtitle}>

  <section class="sec sec-hero" style="max-width:1000px; margin:0 auto; padding:110px 32px 50px">
    <a href="/cases" style="font-family:'Geist',sans-serif; font-size:14px; color:var(--accent); display:inline-block; margin-bottom:32px">← Alle cases</a>
    <div style="height:44px; margin-bottom:28px; display:flex; align-items:center">
      {c.logo
        ? <img class="case-logo" src={c.logo} alt={c.naam} />
        : <span style="font-family:Geist; font-weight:600; font-size:26px; letter-spacing:-.02em; color:var(--text)">{c.naam}</span>}
    </div>
    <h1 style="font-family:Geist; font-weight:600; font-size:clamp(30px,3.6vw,52px); line-height:1.06; letter-spacing:-.035em; margin:0; max-width:24ch; text-wrap:balance">{c.title}</h1>
    <p style="font-size:19px; line-height:1.6; color:rgba(var(--fg),.68); margin:26px 0 0; max-width:60ch; text-wrap:pretty">{c.subtitle}</p>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07); border-bottom:1px solid rgba(var(--ov),.07)">
    <div class="sec" style="max-width:1000px; margin:0 auto; padding:36px 32px; display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:28px">
      {c.meta.map((m) => (
        <div>
          <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.14em; text-transform:uppercase; color:rgba(var(--fg),.42); margin-bottom:8px">{m.k}</div>
          <div style="font-size:16px; line-height:1.5; color:var(--text)">{m.v}</div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="sec" style="max-width:820px; margin:0 auto; padding:70px 32px 40px; display:grid; gap:54px">

      <div>
        <h2 class="case-h">De situatie</h2>
        {c.situatie.map((p) => <p class="case-p">{p}</p>)}
      </div>

      <div>
        <h2 class="case-h">De waarom-nog-vraag</h2>
        {c.waarom.map((p) => <p class="case-p">{p}</p>)}
      </div>

      <div>
        <h2 class="case-h">Wat er hertekend is</h2>
        {c.hertekendIntro && <p class="case-p">{c.hertekendIntro}</p>}
        {c.hertekend.length > 0 && (
          <div style="display:grid; gap:1px; background:rgba(var(--ov),.08); border:1px solid rgba(var(--ov),.08); margin-top:20px">
            {c.hertekend.map((h) => (
              <div style="background:var(--panel); padding:24px 26px">
                <div style="font-family:Geist; font-weight:600; font-size:17px; letter-spacing:-.01em; margin-bottom:6px">{h.kop}</div>
                <div style="font-size:16px; line-height:1.55; color:rgba(var(--fg),.66)">{h.tekst}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      {c.ai.length > 0 && (
        <div style="border:1px solid rgba(43,216,168,.28); background:linear-gradient(180deg, rgba(0,120,97,.10) 0%, var(--panel) 55%); padding:32px 30px">
          <h2 class="case-h" style="margin-top:0">Waar hier wel en geen AI zit</h2>
          {c.ai.map((p) => <p class="case-p">{p}</p>)}
        </div>
      )}

      {c.extra && (
        <div>
          <h2 class="case-h">{c.extra.kop}</h2>
          {c.extra.paras.map((p) => <p class="case-p">{p}</p>)}
        </div>
      )}

      <div>
        <h2 class="case-h">Wat het oplevert</h2>
        {c.oplevert.map((groep) => (
          <div style="margin-top:8px">
            {groep.kop && <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); margin:22px 0 12px">{groep.kop}</div>}
            <div style="display:grid; gap:12px">
              {groep.items.map((it) => (
                <div style="display:grid; grid-template-columns:22px 1fr; gap:12px; align-items:start"><span style="color:var(--accent); font-family:'Geist',sans-serif; font-size:15px">+</span><span style="font-size:16px; line-height:1.55; color:rgba(var(--fg),.72)">{it}</span></div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div style="border-left:2px solid var(--accent); padding:6px 0 6px 24px">
        <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); margin-bottom:12px">De kern</div>
        <p style="font-family:Geist; font-weight:600; font-size:clamp(20px,2.4vw,26px); line-height:1.35; letter-spacing:-.02em; margin:0; color:var(--text)">{c.kern}</p>
      </div>

    </div>
  </section>

  <section style="border-top:1px solid rgba(var(--ov),.07)">
    <div class="sec stack-2" style="max-width:1000px; margin:0 auto; padding:70px 32px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:24px">
      <a href={`/cases/${next}`} style="border:1px solid rgba(var(--ov),.1); background:var(--panel); padding:30px 28px; color:var(--text)">
        <div style="font-family:'Geist',sans-serif; font-size:14px; letter-spacing:.12em; text-transform:uppercase; color:rgba(var(--fg),.42)">Volgende case</div>
        <div style="font-family:Geist; font-weight:600; font-size:20px; letter-spacing:-.02em; margin-top:10px">{nextCase.naam}: {nextCase.result}</div>
      </a>
      <a class="btn-cta" href="/contact" style="display:flex; align-items:center; justify-content:center; text-align:center; background:#007861; color:#FFFFFF; font-family:'Geist',sans-serif; padding:30px 28px; border:1px solid #00A583">Zoiets voor jouw bedrijf? Plan een gesprek</a>
    </div>
  </section>

</Base>

<style>
  .case-h { font-family: Geist; font-weight: 600; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -.025em; margin: 0 0 16px; }
  .case-p { font-size: 17px; line-height: 1.68; color: rgba(var(--fg), .74); margin: 0 0 14px; }
</style>
